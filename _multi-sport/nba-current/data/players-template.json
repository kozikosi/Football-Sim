// NBA Current Player Database — Template
// Format: array of player objects
// Source: NBA2K ratings (Owner can transmit directly) or collective creation
// Format proposed by Beam (S-1600s), pending Owner approval of stat columns

// SCHEMA
// {
//   "name": "string — player's full name",
//   "pos": "string — position code (PG, SG, SF, PF, C)",
//   "team": "string — team name (from TEAMS list)",
//   "ovr": "number — overall rating (0-99)",
//   "pts": "number — points per game",
//   "reb": "number — rebounds per game",
//   "ast": "number — assists per game",
//   "stl": "number — steals per game",
//   "blk": "number — blocks per game",
//   "tov": "number — turnovers per game",
//   "fg": "number — field goal % (0-100)",
//   "tp": "number — 3-point % (0-100)",
//   "ft": "number — free throw % (0-100)",
//   "spd": "number — speed (0-99)",
//   "str": "number — strength (0-99)",
//   "agi": "number — agility (0-99)",
//   "awr": "number — awareness/IQ (0-99)",
//   "inj": "number — injury/durability (0-99, higher = more durable)",
//   "xf": "string|null — X-factor name (optional)",
//   "source": "string — how this rating was derived"
// }

// POSITIONS (5 starter slots + bench)
// PG (point guard), SG (shooting guard), SF (small forward), PF (power forward), C (center)
// Bench depth: BENCH1, BENCH2, BENCH3, BENCH4, BENCH5

// TEAMS (30 NBA teams)
// Atlanta Hawks, Boston Celtics, Brooklyn Nets, Charlotte Hornets, Chicago Bulls,
// Cleveland Cavaliers, Dallas Mavericks, Denver Nuggets, Detroit Pistons, Golden State Warriors,
// Houston Rockets, Indiana Pacers, LA Clippers, Los Angeles Lakers, Memphis Grizzlies,
// Miami Heat, Milwaukee Bucks, Minnesota Timberwolves, New Orleans Pelicans, New York Knicks,
// Oklahoma City Thunder, Orlando Magic, Philadelphia 76ers, Phoenix Suns, Portland Trail Blazers,
// Sacramento Kings, San Antonio Spurs, Toronto Raptors, Utah Jazz, Washington Wizards

// FLEX RULES (proposed — pending Owner approval)
// PG <-> SG: -3 OVR (combo guard)
// SG <-> SF: -3 OVR (wing)
// SF <-> PF: -3 OVR (forward)
// PF <-> C: -3 OVR (big)
// PG <-> SF: -7 OVR (two apart)
// SG <-> PF: -7 OVR (two apart)
// SF <-> C: -7 OVR (two apart)
// PG <-> PF: -12 OVR (three apart)
// SG <-> C: -12 OVR (three apart)
// PG <-> C: -15 OVR (four apart — not recommended)

