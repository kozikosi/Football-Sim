// NFL All-Time Player Database — Template
// Format: array of player objects
// Source: collectively created by the council (no existing dataset)
// Era adjustment: applied to OVR per Owner's era tiers (see QUESTIONS-FOR-OWNER.md Q-NFL-AT-1)

// SCHEMA
// {
//   "name": "string — player's full name",
//   "pos": "string — position code (see POSITIONS below)",
//   "team": "string — primary team (team name from TEAMS list)",
//   "era": "string — decade of peak (e.g., '1980s', '2000s', '2020s')",
//   "ovr": "number — overall rating (0-99, with era adjustment applied)",
//   "spd": "number — speed (0-99)",
//   "str": "number — strength (0-99)",
//   "agi": "number — agility (0-99)",
//   "cod": "number — change of direction (0-99)",
//   "inj": "number — injury rating (0-99, higher = more durable)",
//   "awr": "number — awareness (0-99)",
//   "xf": "string|null — X-factor name (optional)",
//   "source": "string — how this rating was derived (Owner input, consensus, cited reference)"
// }

// POSITIONS (26 starter slots)
// QB, RB1, RB2, WR1, WR2, WR3, WR4, TE1, TE2, OT1, OT2, OG1, OG2, C,
// DE1, DE2, DT1, DT2, DL5, MIKE, WILL, SAM, LB4, CB1, CB2, CB3, CB4, SS, SS2, FS, FS2, K, P, FB

// TEAMS (32 NFL teams)
// Arizona Cardinals, Atlanta Falcons, Baltimore Ravens, Buffalo Bills, Carolina Panthers,
// Chicago Bears, Cincinnati Bengals, Cleveland Browns, Dallas Cowboys, Denver Broncos,
// Detroit Lions, Green Bay Packers, Houston Texans, Indianapolis Colts, Jacksonville Jaguars,
// Kansas City Chiefs, Las Vegas Raiders, Los Angeles Chargers, Los Angeles Rams, Miami Dolphins,
// Minnesota Vikings, New England Patriots, New Orleans Saints, New York Giants, New York Jets,
// Philadelphia Eagles, Pittsburgh Steelers, San Francisco 49ers, Seattle Seahawks, Tampa Bay Buccaneers,
// Tennessee Titans, Washington Commanders

