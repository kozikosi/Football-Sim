// Soccer Current Player Database — Template
// Format: array of player objects
// Source: collectively created by the council using chosen soccer source (e.g., clubelo.com Elo ratings, Transfermarkt, FIFA ratings)
// Era adjustment: not applicable for current players; all-time players get era adjustment per Owner's tiers
//
// SCHEMA
// {
//   "name": "string — player's full name",
//   "pos": "string — position code (see POSITIONS below)",
//   "team": "string — club team (team name from LEAGUES/TEAMS list)",
//   "league": "string — league name (e.g., 'Premier League', 'La Liga', 'Bundesliga', 'Serie A', 'Ligue 1', 'MLS')",
//   "era": "string — current season (e.g., '2024-25') or era for all-time",
//   "ovr": "number — overall rating (0-99, era-adjusted if all-time)",
//   "pac": "number — pace (0-99)",
//   "sho": "number — shooting (0-99)",
//   "pas": "number — passing (0-99)",
//   "dri": "number — dribbling (0-99)",
//   "def": "number — defending (0-99)",
//   "phy": "number — physical (0-99)",
//   "xf": "string|null — X-factor name (optional, soccer-specific traits)",
//   "source": "string — how this rating was derived (source name, method, confidence)"
// }
//
// POSITIONS (11 starting slots per team, plus depth)
// GK, RB, LB, CB1, CB2, CDM, CM, CAM, RW, LW, ST
// Depth: GK2, RB2, LB2, CB3, CB4, CDM2, CM2, CAM2, RW2, LW2, ST2
// Total: ~22 slots per team
//
// LEAGUES (Target: top 5 European leagues + MLS)
// Premier League (England), La Liga (Spain), Bundesliga (Germany), Serie A (Italy), Ligue 1 (France), MLS (USA)
//
// TEAMS (examples per league)
// Premier League: Arsenal, Aston Villa, Brentford, Brighton, Chelsea, Crystal Palace, Everton, Fulham, Ipswich, Leicester, Liverpool, Man City, Man United, Newcastle, Nottingham Forest, Southampton, Tottenham, West Ham, Wolves
