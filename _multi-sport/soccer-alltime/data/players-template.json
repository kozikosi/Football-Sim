// Soccer All-Time Player Database — Template
// Format: array of player objects
// Source: collectively created by the council using chosen soccer source (e.g., clubelo.com Elo ratings, Transfermarkt, FIFA historical ratings, IFFHS)
// Era adjustment: applied to OVR per Owner's era tiers (see QUESTIONS-FOR-OWNER.md Q-SOCCER-AT-1)
//
// SCHEMA
// {
//   "name": "string — player's full name",
//   "pos": "string — position code (see POSITIONS below)",
//   "team": "string — primary club team (team name from LEAGUES/TEAMS list)",
//   "league": "string — league name (e.g., 'Premier League', 'La Liga', 'Bundesliga', 'Serie A', 'Ligue 1', 'MLS', 'European Cup/Champions League')",
//   "era": "string — decade of peak (e.g., '1950s', '1970s', '1990s', '2000s', '2010s', '2020s')",
//   "ovr": "number — overall rating (0-99, with era adjustment applied)",
//   "pac": "number — pace (0-99)",
//   "sho": "number — shooting (0-99)",
//   "pas": "number — passing (0-99)",
//   "dri": "number — dribbling (0-99)",
//   "def": "number — defending (0-99)",
//   "phy": "number — physical (0-99)",
//   "xf": "string|null — X-factor name (optional, soccer-specific traits)",
//   "source": "string — how this rating was derived (Owner input, consensus, cited reference)"
// }
//
// POSITIONS (11 starting slots per team, plus depth)
// GK, RB, LB, CB1, CB2, CDM, CM, CAM, RW, LW, ST
// Depth: GK2, RB2, LB2, CB3, CB4, CDM2, CM2, CAM2, RW2, LW2, ST2
// Total: ~22 slots per team
//
// LEAGUES (Historical + Current)
// Premier League, La Liga, Bundesliga, Serie A, Ligue 1, MLS,
// European Cup/Champions League, Copa Libertadores, World Cup, European Championship, Copa América
//
// TEAMS (Historical + Current)
// All current teams plus historical greats: Real Madrid, Barcelona, Bayern Munich, AC Milan, Juventus, Liverpool, Manchester United, Ajax, Ajax, Benfica, Porto, Celtic, Rangers, Boca Juniors, River Plate, Santos, Flamengo, etc.
//
// ERA ADJUSTMENT TIERS (proposed - pending Owner approval)
// Pre-1960: pac -10, sho -5, pas -5, dri -5, def +5, phy +5
// 1960s-1980s: pac -5, sho -2, pas -2, dri -2, def +2, phy +2
// 1990s-2000s: baseline (no adjustment)
// 2000s-2010s: pac +2, sho +2, pas +2, dri +2, def -2, phy -2
// 2010s-present: pac +5, sho +3, pas +3, dri +3, def -3, phy -3
//
