{
  "name": "cakepanz-67",
  "private": true,
  "version": "0.6.0-shell",
  "type": "module",
  "description": "67 Cakepanz (Z.ai's parallel Colors implementation). The user-facing brand is 76 Pancakes; the track name is for the builders. The complete shell: draft + season + shareables.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:engine": "node --test --experimental-strip-types test/engine.test.ts",
    "battery": "node batteries/slice1.battery.mjs",
    "distfile": "vite build && node scripts/distfile.mjs",
    "battery:node": "node --import ./scripts/node-port-register.mjs batteries/node.battery.mjs",
    "battery:late": "node --import ./scripts/node-port-register.mjs batteries/late.battery.mjs",
    "precompile": "node scripts/precompile-engine.mjs"
  },
  "dependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.19.2",
    "playwright": "1.57.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
