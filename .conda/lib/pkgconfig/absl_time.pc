Name: absl_time
Description: Abseil time library
URL: https://abseil.io/
Version: 20260526
Requires: absl_base = 20260526, absl_civil_time = 20260526, absl_core_headers = 20260526, absl_int128 = 20260526, absl_raw_logging_internal = 20260526, absl_strings = 20260526, absl_time_zone = 20260526
Libs: -L${libdir}  -labsl_time 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
