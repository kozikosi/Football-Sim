{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**/scratch/*.js"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "vcs": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnreachable": "error",
        "noSelfAssign": "error",
        "noConstantCondition": "error",
        "noUndeclaredVariables": "error",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noRedeclare": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateCase": "error",
        "noFallthroughSwitchClause": "error",
        "noGlobalAssign": "error",
        "noSparseArray": "error",
        "noDebugger": "error",
        "noAssignInExpressions": "warn",
        "noDoubleEquals": "warn",
        "noVar": "warn"
      },
      "preset": "none"
    }
  }
}