 // ---------- git IO ----------
+// BUILD-6: Wave ledger — digest reads _agents/waves/LEDGER.md from origin/gh-pages via git.
+// Format: lines like "- P-232: FAILED - auto lineup still broken" or "- P-232: VERIFIED" or "- P-232: CLAIMED"
+// Only VERIFIED hides an item from "ready to build". FAILED shows open with note. CLAIMED shows "awaiting QA".
+// Fallback: if no LEDGER.md, parse the embedded <!-- WAVE: wXX / CLAIMS: ... --> comments from wave HTML files.
+const loadWaveLedger = () => {
+  const ledger = new Map();
+  const text = g('show', 'origin/gh-pages:_agents/waves/LEDGER.md');
+  if (text) {
+    for (const line of text.split('\n')) {
+      const m = /^\s*-\s*(P-\d+)\s*:\s*(CLAIMED|VERIFIED|FAILED)\s*(?:-\s*(.*))?$/.exec(line);
+      if (m) ledger.set(m[1], { state: m[2], note: (m[3] || '').trim() });
+    }
+    return ledger;
+  }
+  // Fallback: parse WAVE comments from HTML files on gh-pages
+  const files = g('ls-tree', '-r', '--name-only', 'origin/gh-pages').split('\n').filter((f) => f.endsWith('.html'));
+  for (const f of files.slice(0, 20)) { // cap at 20 files to avoid slow fetch
+    const html = g('show', `origin/gh-pages:${f}`);
+    const m = /<!--\s*WAVE:\s*(\w+)\s*\/\s*CLAIMS:\s*(.*?)\s*-->/.exec(html);
+    if (m && m[2].trim().toLowerCase() !== 'none') {
+      for (const cm of m[2].matchAll(/(P-\d+)/g)) {
+        if (!ledger.has(cm[1])) ledger.set(cm[1], { state: 'CLAIMED', note: `claimed in ${m[1]} (no ledger)` });
+      }
+    }
+  }
+  return ledger;
+};
