{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kozikosi/Football-Sim/blob/main/tests/OPENCHAMBER-E2E-RESULT.schema.json",
  "title": "OpenChamber NFL Simulator E2E Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "runAtUtc",
    "status",
    "runner",
    "gitRef",
    "gitCommit",
    "artifactPath",
    "artifactSha256",
    "steps",
    "consoleErrors",
    "pageErrors",
    "viewportChecks",
    "screenshots",
    "trace",
    "skippedChecks",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "OPENCHAMBER-E2E-NFL-1" },
    "runAtUtc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"] },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "browser", "browserVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 }
      }
    },
    "gitRef": { "type": "string", "minLength": 1 },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
    "artifactPath": { "type": "string", "minLength": 1 },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "details"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "SKIP", "BLOCKED"] },
          "startedAtUtc": { "type": ["string", "null"], "format": "date-time" },
          "durationMs": { "type": ["integer", "null"], "minimum": 0 },
          "details": { "type": "string" }
        }
      }
    },
    "consoleErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "stepId"],
        "properties": {
          "message": { "type": "string" },
          "stepId": { "type": "string" },
          "location": { "type": ["string", "null"] }
        }
      }
    },
    "pageErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "stepId"],
        "properties": {
          "message": { "type": "string" },
          "stepId": { "type": "string" },
          "stack": { "type": ["string", "null"] }
        }
      }
    },
    "seasonMetrics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "draftPicks": { "type": ["integer", "null"], "minimum": 0 },
        "regularSeasonGamesPlayed": { "type": ["integer", "null"], "minimum": 0 },
        "playoffRoundsCompleted": { "type": ["integer", "null"], "minimum": 0 },
        "championVisible": { "type": ["boolean", "null"] },
        "reportRendered": { "type": ["boolean", "null"] },
        "reportDurationMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "viewportChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpoint", "width", "height", "documentScrollWidth", "bodyScrollWidth", "pageOverflowPx", "overflowElements", "screenshot"],
        "properties": {
          "checkpoint": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "documentScrollWidth": { "type": "integer", "minimum": 0 },
          "bodyScrollWidth": { "type": "integer", "minimum": 0 },
          "pageOverflowPx": { "type": "number" },
          "overflowElements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selector", "bounds", "nearestScrollContainer", "intentional"],
              "properties": {
                "selector": { "type": "string" },
                "bounds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["left", "right", "top", "bottom", "width", "height"],
                  "properties": {
                    "left": { "type": "number" },
                    "right": { "type": "number" },
                    "top": { "type": "number" },
                    "bottom": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  }
                },
                "nearestScrollContainer": { "type": ["string", "null"] },
                "intentional": { "type": "boolean" }
              }
            }
          },
          "screenshot": { "type": ["string", "null"] }
        }
      }
    },
    "screenshots": { "type": "array", "items": { "type": "string" } },
    "trace": { "type": ["string", "null"] },
    "skippedChecks": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}