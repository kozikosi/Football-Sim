+import { ref } from 'vue'
+import { defineStore } from 'pinia'
+import { simulateMatch, type MatchResult } from '../engine/ringers'
+
+export const useRingersStore = defineStore('ringers', () => {
+  const seed = ref(2027)
+  const result = ref<MatchResult | null>(null)
+
+  function sim() {
+    result.value = simulateMatch(seed.value)
+  }
+
+  sim()
+
+  return { seed, result, sim }
+})
