{
  "name": "football-sim-svelte",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run check && npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "smoke": "node scripts/report-tooling.mjs && playwright test tests/smoke.spec.ts",
    "postbuild": "node scripts/strip-crossorigin.mjs && node scripts/singlefile.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@tanstack/svelte-table": "^9.3.2"
  }
}
